<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="GoalKeeperPlay">
      <ReactiveSequence >
         <SelfLocate mode="trust_direction" />
         <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />

         <!-- ══════════════════════════════════════════════ -->
         <!-- PRE-GAME: Waiting for opponent kickoff        -->
         <!-- ══════════════════════════════════════════════ -->
         <ReactiveSequence _while="wait_for_opponent_kickoff" name="等待对方开球">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SetVelocity />
         </ReactiveSequence>

         <!-- ══════════════════════════════════════════════ -->
         <!-- BALL OUT: Return to field                     -->
         <!-- ══════════════════════════════════════════════ -->
         <Sequence _while="!wait_for_opponent_kickoff &amp;&amp; ball_out">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <GoBackInField />
            <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
         </Sequence>

         <!-- ══════════════════════════════════════════════ -->
         <!-- NORMAL PLAY: Shot detection overrides normal  -->
         <!-- ══════════════════════════════════════════════ -->
         <ReactiveSequence _while="!wait_for_opponent_kickoff &amp;&amp; !ball_out">

            <!-- v1.3: Continuous shot monitoring -->
            <ShotDetector shot_detected="{shot_detected}"
                          shot_direction="{shot_direction}"
                          shot_intercept_y="{shot_intercept_y}"
                          shot_time_to_impact="{shot_time_to_impact}" />

            <!-- ══════════════════════════════════════════════ -->
            <!-- PRIORITY 1: Shot incoming → dive then clear  -->
            <!-- ══════════════════════════════════════════════ -->
            <Sequence _while="shot_detected">
               <DivingSave direction="{shot_direction}"
                           intercept_y="{shot_intercept_y}"
                           time_to_impact="{shot_time_to_impact}" />
               <QuickClear />
               <!-- Reset shot flag after save cycle -->
               <Script code="shot_detected=false" />
            </Sequence>

            <!-- ══════════════════════════════════════════════ -->
            <!-- PRIORITY 2: Normal goalie play (no shot)      -->
            <!-- ══════════════════════════════════════════════ -->
            <Sequence _while="!shot_detected">
               <Sequence _while="goalie_mode=='attack'">
                  <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                  <GoalieDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.0" />

                  <!-- v1.3: Improved trajectory-aware positioning -->
                  <ImprovedGoaliePosition _while="decision=='find' || decision=='retreat'"
                     theta_tolerance="0.2" dist_to_goalline="1.0" />

                  <Chase   _while="decision == 'chase'"
                     vx_limit="1.5" vy_limit="0.3" vtheta_limit="1.0"
                     dist="0.4" safe_dist="0.6" />
                  <Adjust  _while="decision == 'adjust'"
                     turn_threshold="0.2" range="0.3"
                     vx_limit="0.3" vy_limit="0.2" vtheta_limit="1.0" />
                  <Sequence _while="decision == 'kick'">
                     <Kick speed_limit="1.2" min_msec_kick="600"/>
                  </Sequence>
               </Sequence>

               <!-- Guard mode: passive goalie on the line -->
               <ReactiveSequence _while="goalie_mode == 'guard'">
                  <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                  <GoToReadyPosition _while="!ball_location_known" vx_limit="0.7" />
                  <GoToGoalBlockingPosition _while="ball_location_known" theta_tolerance="0.2" />
               </ReactiveSequence>
            </Sequence>

         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
